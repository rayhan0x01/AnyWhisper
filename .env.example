# AnyWhisper Configuration
# Copy this file to .env and edit as needed:
#   cp .env.example .env

# --- Whisper API ---
# WHISPER_API_URL=http://localhost:4444/v1/audio/transcriptions

# --- Audio Recording ---
# SAMPLE_RATE=16000
# CHANNELS=1
# AUDIO_FORMAT=wav

# --- Recording Behavior ---
# MAX_RECORDING_DURATION=240
# SILENCE_THRESHOLD=0.01
# SILENCE_DURATION=4.0

# --- Notifications ---
# ENABLE_NOTIFICATIONS=true

# --- Text Injection ---
# USE_COPY_PASTE_METHOD=true

# --- Logging ---
# LOG_LEVEL=INFO

# --- Post-Transcription Actions ---
# ENABLE_TRANSCRIPTION_ACTIONS=true
# POST_TRANSCRIPTION_OPT_DOT=true

# --- AI Processing ---
# ENABLE_AI_PROCESSING=true
# AI_API_KEY=
# AI_PROVIDER=gemini
# AI_MODEL_NAME=gemini-2.5-flash-lite

# --- Daemon ---
# SOCKET_PATH=/tmp/voice_to_text.sock
